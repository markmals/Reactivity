{
    "editor.stickyScroll.enabled": true,
    "editor.inlayHints.enabled": "offUnlessPressed",

    "editor.defaultFormatter": "dprint.dprint",
    "editor.formatOnSave": true,

    "[swift]": {
        "editor.defaultFormatter": "swiftlang.swift-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "dprint.dprint"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "dprint.dprint"
    },
    "[toml]": {
        "editor.defaultFormatter": "dprint.dprint"
    },
    "[markdown]": {
        "editor.defaultFormatter": "dprint.dprint"
    },

    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "Package.swift": ".swift-format*, dprint.json*, mise.toml",
        "readme*": "agents.md, authors, backers*, changelog*, citation*, code_of_conduct*, codeowners, contributing*, contributors, copying, credits, claude.md, governance.md, history.md, license*, maintainers, readme*, security.md, sponsors*",
        ".env": "*.env, .env.*, .envrc, env.d.ts"
    },
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.build": true,
        "**/.swiftpm": true,
        "**/Package.resolved": true
    },

    "todohighlight.keywords": [
        "MARK:",
        {
            "text": "FIXME:",
            "backgroundColor": "#F14848"
        },
        {
            "text": "TODO:",
            "backgroundColor": "#3593FF"
        }
    ],
    "todohighlight.defaultStyle": {
        "backgroundColor": "#434B54",
        "color": "#fff",
        "borderRadius": "2px"
    }
}
