{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "json": {
        "lineWidth": 100,
        "indentWidth": 4,
        "trailingCommas": "jsonc",
        "jsonTrailingCommaFiles": [".vscode/*.json"]
    },
    "toml": {
        "lineWidth": 100,
        "indentWidth": 4
    },
    "markdown": {
        "textWrap": "never"
    },
    "includes": [
        "**/*.json",
        "**/*.toml",
        "**/*.{md,markdown}"
    ],
    "excludes": [
        "**/.git",
        "/.build",
        "/Packages",
        "xcuserdata/",
        "DerivedData/",
        ".swiftpm/",
        ".netrc"
    ],
    "plugins": [
        "https://plugins.dprint.dev/json-0.19.3.wasm",
        "https://plugins.dprint.dev/toml-0.7.0.wasm",
        "https://plugins.dprint.dev/markdown-0.17.8.wasm"
    ]
}
